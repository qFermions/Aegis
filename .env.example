# Environment-variable reference for Aegis scripts.
# The zero-dependency scripts do not auto-load .env; export these values in the
# current shell or configure them in CI. Never commit a populated env file.
# Names and placeholders only: secrets stay empty here and live in the secret manager;
# org values are [@Aegion_*] placeholders (modules/security/placeholder-dictionary.md).
# scripts/env-example.test.js fails when a connector, the Jira client, the intake or the
# audit trail reads a name that is not listed below.

# Used by scripts/security-audit.js
TENANT=[@Aegion_DOMAIN]
AUDITOR=[ADMIN_NAME]

# Tenant and org literal detection in scripts/pre-commit-check.js; the intake's email source binds to AEGION_DOMAIN
AEGION_DOMAIN=
AEGION_ORG_NAME=

# Jira Service Management; keep the API token in the shell or secret manager
JIRA_SITE=[@Aegion_JIRA_URL]
JIRA_EMAIL=[USER@DOMAIN.COM]
JIRA_API_TOKEN=
JIRA_SERVICE_DESK_ID=
JIRA_REQUEST_TYPE_ID=

# Fleet (scripts/adapters/fleet-client.js): the server host, and the API-only Observer user's token
FLEET_URL=[@Aegion_FLEET_URL]
FLEET_API_TOKEN=

# Jamf Pro (scripts/adapters/jamf-client.js): the server host, and the read-only API client's ID and secret
JAMF_URL=[@Aegion_JAMF_URL]
JAMF_CLIENT_ID=
JAMF_CLIENT_SECRET=

# Slack (scripts/adapters/slack-client.js and the intake): the workspace ID, the read token, and the admin token exported for access-logs only
SLACK_TEAM_ID=[@Aegion_SLACK_TEAM_ID]
SLACK_TOKEN=
SLACK_ACCESS_LOGS_TOKEN=

# Linear (scripts/adapters/linear-client.js and the intake): the workspace URL key, and a read-only API key
LINEAR_ORG=[@Aegion_LINEAR_ORG]
LINEAR_API_KEY=

# Google Workspace (scripts/adapters/gws-client.js): the customer ID, and the read-only service account's email, private key and admin subject
GWS_CUSTOMER_ID=[@Aegion_GWS_CUSTOMER_ID]
GWS_SA_CLIENT_EMAIL=
GWS_SA_PRIVATE_KEY=
GWS_ADMIN_SUBJECT=

# Okta (scripts/adapters/okta-client.js): the org host, and the read-only service app's client ID, private key and optional key ID
OKTA_ORG_URL=[@Aegion_OKTA_ORG_URL]
OKTA_CLIENT_ID=
OKTA_PRIVATE_KEY=
OKTA_KEY_ID=

# Microsoft Graph (scripts/adapters/msgraph-client.js): the tenant ID, the read-only app's client ID, certificate key and thumbprint, and the user object ID scopes.js --execute reads
MS_TENANT_ID=[@Aegion_MS_TENANT_ID]
MS_CLIENT_ID=
MS_PRIVATE_KEY=
MS_CERT_SHA256=
MS_SCOPE_CHECK_USER=

# GitHub (scripts/adapters/github-client.js and the intake): the organization login, and a read-only fine-grained token
GITHUB_ORG=[@Aegion_GITHUB_ORG]
GITHUB_TOKEN=

# Local state: the audit trail folder (default .aegis-state/audit) and the graph runs folder the intake saves to (default tasks/graph-runs)
AEGIS_AUDIT_DIR=
AEGIS_GRAPH_RUNS_DIR=

# Test switch set by scripts/adapters/socket-tripwire.js: 1 refuses every network connection; leave it empty
AEGIS_NETWORK_TRIPWIRE=

# Optional init-memory.js overrides; the default key derives from the Git root
MEMORY_DIR=
PROJECT_KEY=
