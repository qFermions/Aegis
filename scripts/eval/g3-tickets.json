      "text": "GitHub: [FIRST_NAME] [LAST_NAME] left on Friday; remove [GITHUB_USER] from the GitHub organization.",
      "expectFloor": "T3",
      "expectTriggers": [
        "github member"
      ],
      "expectDecision": "GATE",
      "route": [
        "github-offboard-member"
      ]
    },
    {
